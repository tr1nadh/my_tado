{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Karya",
  "version": "1.1.3",
  "identifier": "com.karya.desktop",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Karya",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEzQjQzOTlDMUU4NzQ0RkEKUldUNlJJY2VuRG0wRXlteXE3TDlsZUI3dk5GS3FwSFd5dit0cWJMZ2tFeVQ3cUtzWXhUUVYrN3MK",
      "endpoints": [
        "https://github.com/tr1nadh/my_tado/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
